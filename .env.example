# PrismLens — GitHub Token (required for the CLI and for the automated
# webhook responder — the web UI instead takes a token per request)
# Get one at: https://github.com/settings/tokens (select repo scope)
GITHUB_TOKEN=ghp_your_token_here

# Server port (optional, defaults to 3000)
PORT=3000

# Required only for the automated PR-comment responder
# (POST /api/webhooks/github). Set this to the same secret you enter when
# registering the webhook on a repo (Settings > Webhooks > Add webhook).
GITHUB_WEBHOOK_SECRET=

# AI review/chat backend — set any ONE of these to enable it server-wide
# without anyone needing to connect a key in the Model page. Every provider
# below is called directly over HTTPS (no CLI, no install), so this works
# out of the box on Vercel or any other host. The server tries them in the
# order listed and uses the first one with a key set; a per-provider *_MODEL
# is optional and falls back to a sensible default. Falls back to
# pattern-based (regex) review/chat is unavailable if nothing here is set
# (a user can still connect their own key in the Model page instead).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
