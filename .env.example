# PrismLens — GitHub Token (required for the CLI and for the automated
# webhook responder — the web UI instead takes a token per request)
# Get one at: https://github.com/settings/tokens (select repo scope)
GITHUB_TOKEN=ghp_your_token_here

# Server port (optional, defaults to 3000)
PORT=3000

# Required only for the automated PR-comment responder
# (POST /api/webhooks/github). Set this to the same secret you enter when
# registering the webhook on a repo (Settings > Webhooks > Add webhook).
GITHUB_WEBHOOK_SECRET=

# AI code review backend. Get a free key at https://aistudio.google.com/apikey
# When set, this is used instead of the opencode CLI — no binary to install
# or ship, and it works out of the box on Vercel. Falls back to pattern-based
# (regex) review if unset or if a request fails.
GEMINI_API_KEY=
# Optional, defaults to gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash
